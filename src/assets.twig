                                        {{ i }}
                                    {% endif %}
                                </a></li>
                        {% endfor %}
                        {% if searchResults.PAGINATION.PAGE < searchResults.PAGINATION['TOTAL-PAGES'] %}
                            <li class="page-item"><a class="page-link" href="#" data-page="{{searchResults.PAGINATION.PAGE+1}}">&raquo;</a></li>
