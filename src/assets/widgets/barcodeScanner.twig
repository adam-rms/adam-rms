{#
    Shared USB/Bluetooth barcode scanner widget.

    Parameters (passed via embed/include with):
    - scannerCallback: JavaScript function name (string) to call when a barcode is scanned.
                       The function will be called as: functionName(value, 'UNKNOWN').
    - scannerIdSuffix: Unique suffix for HTML element IDs to allow multiple scanners on a page (default: '')
#}
{% set suffix = scannerIdSuffix|default('') %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-keyboard"></i> USB/Bluetooth Scanner</h3>
            </div>
            <div class="card-body">
                <p>Use a USB or Bluetooth barcode scanner, or type a barcode value manually and press Enter.</p>
                <div class="input-group">
                    <input type="text" class="form-control" id="barcodeScanTextInput{{ suffix }}" placeholder="Scan or type barcode value">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" id="barcodeScanTextButton{{ suffix }}">
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
                {% if showAutoReplace|default(false) and "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
                <label class="form-check-label d-inline-flex align-items-center mt-2">
                    <input type="checkbox" class="autoReplaceUnpickedAsset mr-1" id="barcodeAutoReplaceUnpicked{{ suffix }}">
                    Auto-replace unpicked asset
                </label>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<script>
    (function() {
        var suffix = {{ suffix|json_encode|raw }};
        window.playBarcodeSuccessTone = window.playBarcodeSuccessTone || function() {
            try {
                var AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;

                var context = window.__barcodeScannerAudioContext || new AudioContext();
                window.__barcodeScannerAudioContext = context;
                if (context.state === 'suspended') {
                    context.resume().catch(function() {});
                }

                [
                    { frequency: 660, startOffset: 0, duration: 0.11 },
                    { frequency: 880, startOffset: 0.09, duration: 0.13 }
                ].forEach(function(note) {
                    var startAt = context.currentTime + note.startOffset;
                    var tone = context.createOscillator();
                    var gain = context.createGain();
                    tone.type = 'sine';
                    tone.frequency.setValueAtTime(note.frequency, startAt);
                    gain.gain.setValueAtTime(0.0001, startAt);
                    gain.gain.linearRampToValueAtTime(0.09, startAt + 0.008);
                    gain.gain.exponentialRampToValueAtTime(0.0001, startAt + note.duration);
                    tone.connect(gain);
                    gain.connect(context.destination);
                    tone.start(startAt);
                    tone.stop(startAt + note.duration);
                });
            } catch (e) {
                console.error('Barcode success tone failed', e);
            }
        };

        var callbackFn = (function() {
            // Resolve the callback by name when a scan is submitted.
            var callbackName = {{ scannerCallback|json_encode|raw }};
            return function(value, type) {
                if (!callbackName) {
                    console.error("barcodeScanner widget: scannerCallback name not provided.");
                    return;
                }
                var fn = window[callbackName];
                if (typeof fn !== "function") {
                    console.error("barcodeScanner widget: scannerCallback function '" + callbackName + "' not found or not a function.");
                    return;
                }
                try {
                    fn(value, type);
                } catch (e) {
                    console.error("barcodeScanner widget: error while executing scannerCallback '" + callbackName + "':", e);
                }
            };
        })();

        function submitTextBarcode() {
            var $input = $("#barcodeScanTextInput" + suffix);
            var value = $input.val().trim();
            if (value.length > 0) {
                callbackFn(value, "UNKNOWN");
                $input.val("").focus();
            }
        }

        $("#barcodeScanTextInput" + suffix).on("keydown", function(e) {
            if (e.key !== "Enter") return;
            e.preventDefault();
            submitTextBarcode();
        });
        $("#barcodeScanTextButton" + suffix).on("click", submitTextBarcode);
    })();
</script>
