        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Quick Dispatch</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs" role="tablist">
                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="pill" href="#quick-dispatch-modal-board-thisinstance" role="tab" aria-controls="quick-dispatch-modal-board-thisinstance" aria-selected="false">{{ USERDATA.instance.instances_name }}</a>
                        </li>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="pill" href="#quick-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="quick-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="p-3">
                    <div class="tab-content">
                        <div class="tab-pane show active p2" id="quick-dispatch-modal-board-thisinstance" role="tabpanel" aria-labelledby="asset-list-tabs-profile-tab">
                            <p>Enter an asset's tag from {{ USERDATA.instance.instances_name }} to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorQuickDispatch" data-instanceid="{{ USERDATA.instance["instances_id"] }}">
                                    {% for status in BOARDSTATUSES[USERDATA.instance["instances_id"]] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <div class="tab-pane p2" id="quick-dispatch-modal-board-instance{{ instance['instance']['instances_id'] }}">
                            <p>Enter an asset's tag from {{  instance['instance'].instances_name }} tag to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorQuickDispatch" data-instanceid="{{ instance['instance']['instances_id'] }}">
                                    {% for status in BOARDSTATUSES[instance['instance']['instances_id']] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% endfor %}
                    </div>                
                    <div class="form-group">
                        <label>Asset Tag</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="assetTagQuickDispatch" />
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="goQuickDispatch">
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="assetTagResultQuickDispatch"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="barcodeDispatchModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Barcode Dispatch</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="pill" href="#barcode-dispatch-tab-scan" role="tab" aria-controls="barcode-dispatch-tab-scan" aria-selected="true">Scan Barcode</a>
                    </li>
                </ul>
                <div class="p-3">
                    <div class="tab-content">
                        <div class="tab-pane show active p2" id="barcode-dispatch-tab-scan" role="tabpanel">
                            <ul class="nav nav-tabs" role="tablist">
                                {% if FINANCIALS.assetsAssigned|length > 0 %}
                                    <li class="nav-item">
                                        <a class="nav-link active" data-toggle="pill" href="#barcode-dispatch-modal-board-thisinstance" role="tab" aria-controls="barcode-dispatch-modal-board-thisinstance" aria-selected="true">{{ USERDATA.instance.instances_name }}</a>
                                    </li>
                                {% endif %}
                                {% for instance in FINANCIALS.assetsAssignedSUB %}
                                    <li class="nav-item">
                                        <a class="nav-link{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} active{% endif %}" data-toggle="pill" href="#barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <div class="p-3">
                                <div class="tab-content">
                                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                                    <div class="tab-pane show active p2" id="barcode-dispatch-modal-board-thisinstance" role="tabpanel">
                                        <p>Scan a barcode for an asset from {{ USERDATA.instance.instances_name }} to set its status.</p>
                                        <div class="form-group">
                                            <label>Set Asset Status to</label>
                                            <select class="form-control assetStatusSelectorBarcodeDispatch" data-instanceid="{{ USERDATA.instance["instances_id"] }}">
                                                {% for status in BOARDSTATUSES[USERDATA.instance["instances_id"]] %}
                                                <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    {% endif %}
                                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                                    <div class="tab-pane p2{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} show active{% endif %}" id="barcode-dispatch-modal-board-instance{{ instance['instance']['instances_id'] }}">
                                        <p>Scan a barcode for an asset from {{  instance['instance'].instances_name }} to set its status.</p>
                                        <div class="form-group">
                                            <label>Set Asset Status to</label>
                                            <select class="form-control assetStatusSelectorBarcodeDispatch" data-instanceid="{{ instance['instance']['instances_id'] }}">
                                                {% for status in BOARDSTATUSES[instance['instance']['instances_id']] %}
                                                <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                                {% embed 'assets/widgets/barcodeScanner.twig' with {"scannerCallback": "dispatchBarcodeScanned", "scannerIdSuffix": "Dispatch"} %}
                                {% endembed %}
                                <div id="barcodeDispatchResult"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
    });

    if (localStorage.getItem("activeTab-board")) {
        $('a.assetsBoardToggle[href=\'#' + localStorage.getItem("activeTab-board") + '\']').tab('show');
    }

    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}

    // Whether the user can assign assets to projects (for Supermarket Sweep)
    const canAssignAssets = {{ "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions ? 'true' : 'false' }};

    // Create an array of status ids, ordered
    const assetStatusesRaw = JSON.parse('{{ BOARDSTATUSES|json_encode|raw }}');
    var assetStatuses = {};
    for (const [instanceid, instanceStatuses] of Object.entries(assetStatusesRaw)) {
        var newDir = {"orderedStatusIds": [], "allData": instanceStatuses};
        // In theory, if the statuses have been sorted by the user dragging them around then the orders will be in order and so JS will recognise them as an array. Otherwise they'll be an object (e.g. if someone has deleted a status but not dragged them around)
        if (Array.isArray(instanceStatuses)) {
            instanceStatuses.forEach((item) => {
                newDir["orderedStatusIds"].push(item["assetsAssignmentsStatus_id"]);
            });
        } else if (typeof instanceStatuses === 'object') {
            for (const [key, value] of Object.entries(instanceStatuses)) {
                newDir["orderedStatusIds"].push(value["assetsAssignmentsStatus_id"]);
            }
        }
        assetStatuses[instanceid] = newDir;
    }
    // Show/Hide relevant buttons for touchscreen control
    function drawButtons() {
        $('.assetDispatchAssetList').each(function(){
            var instance = $(this).data("instance");
            var statusid = $(this).data("statusid");
            var position = assetStatuses[instance]['orderedStatusIds'].indexOf(statusid);
            var prev = (position == 0 ? false : assetStatuses[instance]['orderedStatusIds'][position-1]);
            var next = (position == assetStatuses[instance]['orderedStatusIds'].length - 1 ? false : assetStatuses[instance]['orderedStatusIds'][position+1]);

            $(this).find(".assetDispatchAssetList-statusPrevButton").css('display', prev === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusPrevButton").data('nextstatus', prev);
            $(this).find(".assetDispatchAssetList-statusNextButton").css('display', next === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusNextButton").data('nextstatus', next);
        });
    }

    function buildAssetDispatchCard(asset, assignmentId, statusId, instanceId) {
        var card = $("<div>").addClass("row align-middle p-2 border border-secondary border-2 rounded mt-auto mb-2 assetDispatchAssetList-card");
        card.attr("data-currentstatus", statusId);
        card.attr("data-assignment", assignmentId);
        card.attr("data-instance", instanceId);
        card.attr("data-asset", asset.assets_id);

        if (canAssignAssets) {
            card.append($("<button>")
                .addClass("btn btn-outline-secondary assetDispatchAssetList-statusPrevButton col-1")
                .attr("data-nextstatus", "")
                .hide()
                .text("«"));
        }

        var title;
        var title = $("<h6>").addClass("col my-auto");
        if (asset.assets_id) {
            title.append("(");
            title.append($("<a>")
                .attr("target", "_blank")
                .attr("href", "{{ CONFIG.ROOTURL }}/asset.php?id=" + asset.assetTypes_id + "&asset=" + asset.assets_id + "&instance=" + instanceId)
                .text(asset.assets_tag)
            );
            title.append(")");
        } else {
            title.append(document.createTextNode("(" + asset.assets_tag + ")"));
        }
        title.append("<br>");
        title.append(document.createTextNode(asset.assetTypes_name));
        card.append(title);

        if (canAssignAssets) {
            card.append($("<button>")
                .addClass("btn btn-outline-secondary assetDispatchAssetList-statusNextButton col-1")
                .attr("data-nextstatus", "")
                .hide()
                .text("»"));
        }

        return card;
    }

    function upsertAssetDispatchCard(asset, assignmentId, assetStatus, instanceId) {
        var assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-assignment=" + assignmentId + "]");
        if (assetCard.length > 0) {
            assetCard.attr("data-currentstatus", assetStatus);
            assetCard.attr("data-asset", asset.assets_id);
            assetCard.data("asset", asset.assets_id);
            assetCard.data("currentstatus", assetStatus);
            if (asset.assets_id) {
                assetCard.find('a').attr('href', '{{ CONFIG.ROOTURL }}/asset.php?id=' + asset.assetTypes_id + '&asset=' + asset.assets_id + '&instance=' + instanceId).text(asset.assets_tag);
                var title = assetCard.find('h6');
                title.empty();
                title.append("(");
                title.append($("<a>")
                    .attr("target", "_blank")
                    .attr("href", "{{ CONFIG.ROOTURL }}/asset.php?id=" + asset.assetTypes_id + "&asset=" + asset.assets_id + "&instance=" + instanceId)
                    .text(asset.assets_tag)
                );
                title.append(")<br>");
                title.append(document.createTextNode(asset.assetTypes_name));
            } else {
                var title = assetCard.find('h6');
                title.empty();
                title.append(document.createTextNode("(" + asset.assets_tag + ")"));
                title.append("<br>");
                title.append(document.createTextNode(asset.assetTypes_name));
            }
            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
            return assetCard;
        }

        var newCard = buildAssetDispatchCard(asset, assignmentId, assetStatus, instanceId);
        $(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]").append(newCard);
        return newCard;
    }

    /**
     * Function to change the status of an asset assignment
     * @param assetsAssignments_id Id of the AssetAssignment
     * @param assetsAssignments_status new status id of the AssetAssignment
     */
    function changeStatus(assetsAssignments_id, assetsAssignments_status) {
        ajaxcall("projects/assets/setStatus.php", {"assetsAssignments_id":assetsAssignments_id, "assetsAssignments_status":assetsAssignments_status}, function (returned) {
            drawButtons();
            Toast.fire({
                type: 'success',
                title: 'Asset Status Updated'
            });
        });
    }
    /**
     * Function to handle a barcode scan for asset dispatch
     * Called by the shared barcode scanner widget
     * @param value The barcode value
     * @param type The barcode format type ('UNKNOWN' for USB/Bluetooth scanners)
     */
    function focusBarcodeDispatchInput() {
        var $input = $("#barcodeScanTextInputDispatch");
        if ($input.length) {
            $input.focus();
        }
    }

    function notifyScanError() {
        try {
            var AudioContext = window.AudioContext || window.webkitAudioContext;
            if (AudioContext) {
                var ctx = window.__barcodeDispatchAudioContext || new AudioContext();
                window.__barcodeDispatchAudioContext = ctx;
                if (ctx.state === 'suspended') {
                    ctx.resume().catch(function() {});
                }

                var now = ctx.currentTime;
                var firstTone = ctx.createOscillator();
                var firstGain = ctx.createGain();
                firstTone.type = 'square';
                firstTone.frequency.setValueAtTime(440, now);
                firstTone.frequency.linearRampToValueAtTime(260, now + 0.12);
                firstGain.gain.setValueAtTime(0, now);
                firstGain.gain.linearRampToValueAtTime(0.18, now + 0.01);
                firstGain.gain.linearRampToValueAtTime(0, now + 0.12);
                firstTone.connect(firstGain);
                firstGain.connect(ctx.destination);
                firstTone.start(now);
                firstTone.stop(now + 0.12);

                var secondTone = ctx.createOscillator();
                var secondGain = ctx.createGain();
                secondTone.type = 'square';
                secondTone.frequency.setValueAtTime(330, now + 0.18);
                secondTone.frequency.linearRampToValueAtTime(220, now + 0.28);
                secondGain.gain.setValueAtTime(0, now + 0.18);
                secondGain.gain.linearRampToValueAtTime(0.16, now + 0.19);
                secondGain.gain.linearRampToValueAtTime(0, now + 0.28);
                secondTone.connect(secondGain);
                secondGain.connect(ctx.destination);
                secondTone.start(now + 0.18);
                secondTone.stop(now + 0.28);
            }
        } catch (e) {
            console.error('Notification tone failed', e);
        }
    }

    function assignScannedAsset(value, assetId, requestData) {
        $.ajax({
            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/assign.php",
            type: "POST",
            dataType: "json",
            data: {
                projects_id: requestData.projects_id,
                assets_id: assetId
            },
            cache: false,
            success: function(assignResult) {
                if (assignResult.result === true) {
                    $.ajax({
                        url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusBarcode.php",
                        type: "POST",
                        data: requestData,
                        dataType: "json",
                        cache: false,
                        success: function(retryResult) {
                            if (retryResult.result === true) {
                                if (retryResult.response && retryResult.response.assetsAssignments_id) {
                                    var cardAsset = {
                                        assets_id: retryResult.response.assets_id,
                                        assets_tag: retryResult.response.assets_tag,
                                        assetTypes_id: retryResult.response.assetTypes_id,
                                        assetTypes_name: retryResult.response.assetTypes_name
                                    };
                                    upsertAssetDispatchCard(cardAsset, retryResult.response.assetsAssignments_id, requestData.assetsAssignments_status, requestData.instances_id);
                                    drawButtons();
                                }
                                Toast.fire({
                                    type: 'success',
                                    title: 'Asset added to project and dispatched via barcode'
                                });
                                window.playBarcodeSuccessTone();
                            } else {
                                Toast.fire({
                                    type: 'warning',
                                    title: 'Asset added to project but status could not be updated'
                                });
                            }
                            window.barcodeAssignInProgress = false;
                            focusBarcodeDispatchInput();
                        },
                        error: function() {
                            Toast.fire({
                                type: 'warning',
                                title: 'Asset added to project but status could not be updated'
                            });
                            window.barcodeAssignInProgress = false;
                            focusBarcodeDispatchInput();
                        }
                    });
                } else {
                    var assignErrorMsg = assignResult.error ? assignResult.error.message : "Could not assign asset to project";
                    Toast.fire({
                        type: 'error',
                        title: value + ": " + assignErrorMsg
                    });
                    var resultDiv = $("<div>").addClass("alert alert-danger").text(value + ": " + assignErrorMsg);
                    $("#barcodeDispatchResult").prepend(resultDiv);
                    window.barcodeAssignInProgress = false;
                    focusBarcodeDispatchInput();
                }
            },
            error: function() {
                window.barcodeAssignInProgress = false;
                notifyScanError();
                bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection');
            }
        });
    }

    function swapScannedAsset(value, assetId, assignmentId, statusId) {
        $.ajax({
            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/swap.php",
            type: "POST",
            dataType: "json",
            data: {
                assetsAssignments_id: assignmentId,
                assets_id: assetId,
                assetsAssignmentsStatus_id: statusId
            },
            cache: false,
            success: function(swapResult) {
                window.barcodeAssignInProgress = false;
                var card = $(".assetDispatchAssetList-card[data-assignment=" + assignmentId + "]");
                var instanceId = card.length > 0 ? card.data("instance") : null;
                if (swapResult.result === true) {
                    if (swapResult.response && swapResult.response.assetsAssignments_id) {
                        var cardAsset = {
                            assets_id: swapResult.response.assets_id,
                            assets_tag: swapResult.response.assets_tag,
                            assetTypes_id: swapResult.response.assetTypes_id,
                            assetTypes_name: swapResult.response.assetTypes_name
                        };
                        if (instanceId !== null) {
                            upsertAssetDispatchCard(cardAsset, swapResult.response.assetsAssignments_id, statusId, instanceId);
                            drawButtons();
                        }
                    }
                    Toast.fire({
                        type: 'success',
                        title: 'Asset replaced in project'
                    });
                    window.playBarcodeSuccessTone();
                    focusBarcodeDispatchInput();
                } else {
                    notifyScanError();
                    var swapErrorMsg = swapResult.error ? swapResult.error.message : 'Could not replace asset';
                    Toast.fire({
                        type: 'error',
                        title: value + ': ' + swapErrorMsg
                    });
                    var resultDiv = $("<div>").addClass("alert alert-danger").text(value + ': ' + swapErrorMsg);
                    $("#barcodeDispatchResult").prepend(resultDiv);
                    focusBarcodeDispatchInput();
                }
            },
            error: function() {
                window.barcodeAssignInProgress = false;
                notifyScanError();
                Toast.fire({
                    type: 'error',
                    title: 'Could not replace asset. Please try again.'
                });
                focusBarcodeDispatchInput();
            }
        });
    }

    function promptBarcodeReplacement(value, assetId, candidates, assetStatus) {
        if (!candidates || candidates.length === 0) {
            window.barcodeAssignInProgress = false;
            focusBarcodeDispatchInput();
            return;
        }

        if (candidates.length === 1) {
            var candidateText = candidates[0].assets_tag + (candidates[0].asset_definableFields_1 ? ' (' + candidates[0].asset_definableFields_1 + ')' : '') + ' - ' + candidates[0].assetsAssignmentsStatus_name;
            bootbox.confirm({
                title: 'Replace existing asset?',
                message: 'Replace ' + candidateText + ' in the project with this scanned asset?',
                callback: function(confirmed) {
                    if (confirmed) {
                        swapScannedAsset(value, assetId, candidates[0].assetsAssignments_id, assetStatus);
                    } else {
                        window.barcodeAssignInProgress = false;
                        focusBarcodeDispatchInput();
                    }
                }
            });
            return;
        }

        var selectHtml = '<select id="replacementSelect" class="form-control form-control-lg">';
        candidates.forEach(function(item) {
            var text = item.assets_tag + (item.asset_definableFields_1 ? ' (' + item.asset_definableFields_1 + ')' : '') + ' - ' + item.assetsAssignmentsStatus_name;
            selectHtml += '<option value="' + item.assetsAssignments_id + '">' + text + '</option>';
        });
        selectHtml += '</select>';

        bootbox.dialog({
            title: 'Select asset to replace',
            message: '<div class="mb-3">' + selectHtml + '</div>',
            size: 'large',
            buttons: {
                cancel: {
                    label: 'Cancel',
                    className: 'btn-secondary',
                    callback: function() {
                        focusBarcodeDispatchInput();
                    }
                },
                ok: {
                    label: 'Replace',
                    className: 'btn-primary',
                    callback: function() {
                        var selected = $('#replacementSelect').val();
                        if (selected) {
                            swapScannedAsset(value, assetId, selected, assetStatus);
                            return true;
                        } else {
                            window.barcodeAssignInProgress = false;
                            focusBarcodeDispatchInput();
                            return false;
                        }
                    }
                }
            }
        });
    }

    function dispatchBarcodeScanned(value, type) {
        var assetStatus = $(".assetStatusSelectorBarcodeDispatch:visible").val();
        var instanceId = $(".assetStatusSelectorBarcodeDispatch:visible").data("instanceid");
        var requestData = {
            text: value,
            assetsAssignments_status: assetStatus,
            projects_id: {{ project.projects_id }},
            instances_id: instanceId
        };
        if (type && type !== "UNKNOWN") {
            requestData.type = type;
        }
        $.ajax({
            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusBarcode.php",
            type: "POST",
            dataType: "json",
            data: requestData,
            cache: false,
            success: function(result, status, data) {
                if (result.result === true) {
                    window.playBarcodeSuccessTone();
                    if (result.response && result.response.assetsAssignments_id) {
                        var assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-assignment=" + result.response.assetsAssignments_id + "]");
                        if (assetCard.length > 0) {
                            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
                            assetCard.attr("data-currentstatus", assetStatus);
                            assetCard.data("currentstatus", assetStatus);
                        } else {
                            var cardAsset = {
                                assets_id: result.response.assets_id,
                                assets_tag: result.response.assets_tag,
                                assetTypes_id: result.response.assetTypes_id,
                                assetTypes_name: result.response.assetTypes_name
                            };
                            upsertAssetDispatchCard(cardAsset, result.response.assetsAssignments_id, assetStatus, instanceId);
                        }
                    }
                    drawButtons();
                    Toast.fire({
                        type: 'success',
                        title: 'Asset dispatched via barcode'
                    });
                } else if (result.error && result.error.code === "NOTASSIGNED" && ('assets_id' in result.error) && canAssignAssets) {
                    notifyScanError();
                    // Supermarket Sweep: asset exists but is not assigned to this project
                    // Prevent multiple concurrent NOTASSIGNED flows (scanner may fire repeatedly)
                    if (window.barcodeAssignInProgress) {
                        return;
                    }
                    window.barcodeAssignInProgress = true;

                    var swapCandidates = result.error.swapCandidates || [];
                    var conflictText = '';
                    if (result.error && result.error.conflictingAssignment && result.error.conflictingAssignment.projects_name) {
                        conflictText = '<div class="alert alert-warning mb-3">This asset is currently assigned to <strong>' + result.error.conflictingAssignment.projects_name + '</strong> with status <strong>' + result.error.conflictingAssignment.assetsAssignmentsStatus_name + '</strong>.</div>';
                    }
                    if (swapCandidates.length > 0) {
                        bootbox.dialog({
                            title: "Asset not assigned to this project",
                            message: conflictText + "This asset is not currently assigned to this project. Would you like to add it to the project, or replace an existing assigned asset?",
                            onEscape: function() {
                                window.barcodeAssignInProgress = false;
                                focusBarcodeDispatchInput();
                            },
                            buttons: {
                                cancel: {
                                    label: "Cancel",
                                    className: "btn-secondary",
                                    callback: function() {
                                        Toast.fire({
                                            type: 'info',
                                            title: 'Asset not added to project'
                                        });
                                        var resultDiv = $("<div>").addClass("alert alert-warning").text(value + ": Asset not assigned to project - skipped");
                                        $("#barcodeDispatchResult").prepend(resultDiv);
                                        window.barcodeAssignInProgress = false;
                                        focusBarcodeDispatchInput();
                                    }
                                },
                                add: {
                                    label: "Add to project",
                                    className: "btn-success",
                                    callback: function() {
                                        assignScannedAsset(value, result.error.assets_id, requestData);
                                    }
                                },
                                replace: {
                                    label: "Replace asset",
                                    className: "btn-warning",
                                    callback: function() {
                                        promptBarcodeReplacement(value, result.error.assets_id, swapCandidates, assetStatus);
                                    }
                                }
                            }
                        });
                    } else {
                        bootbox.confirm({
                            title: "Add asset to project?",
                            message: conflictText + "This asset is not currently assigned to this project. Would you like to add it to the project and set its status?",
                            callback: function(confirmed) {
                                if (confirmed) {
                                    assignScannedAsset(value, result.error.assets_id, requestData);
                                } else {
                                    Toast.fire({
                                        type: 'info',
                                        title: 'Asset not added to project'
                                    });
                                    var resultDiv = $("<div>").addClass("alert alert-warning").text(value + ": Asset not assigned to project - skipped");
                                    $("#barcodeDispatchResult").prepend(resultDiv);
                                    window.barcodeAssignInProgress = false;
                                    focusBarcodeDispatchInput();
                                }
                            }
                        });
                    }
                } else {
                    notifyScanError();
                    var errorMsg = (result.error && result.error.message) ? result.error.message : "Barcode not found or asset not assigned to project";
                    Toast.fire({
                        type: 'error',
                        title: value + ": " + errorMsg
                    });
                    var resultDiv = $("<div>").addClass("alert alert-danger").text(value + ": " + errorMsg);
                    $("#barcodeDispatchResult").prepend(resultDiv);
                    focusBarcodeDispatchInput();
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error("Barcode dispatch request failed", jqXHR, textStatus, errorThrown);
                notifyScanError();
                Toast.fire({
                    type: 'error',
                    title: 'Could not update asset status. Please try again.'
                });
                focusBarcodeDispatchInput();
            }
        });
    }
    {% endif %}
    $(document).ready(function () {
        {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
        drawButtons();
        $(".assetDispatchAssetList").sortable({
            connectWith: "div",
            update: function( event, ui ){
                /*
                Update function is called twice, once for the old list and once for the new list.
                The lists, this, have a data attribute, status, that can be compared with each asset, ui.item[0].
                If the groupStatus is the same as the old status, this call can be ignored as this is the old list update call.
                Function call will refresh the page and sort any graphical issues.
                 */
                const groupStatus = this.dataset.statusid;
                const assetOldStatus = ui.item[0].dataset.currentstatus;
                const assetAssignment = ui.item[0].dataset.assignment;

                if (assetOldStatus !== groupStatus) {
                    changeStatus(parseInt(assetAssignment),parseInt(groupStatus));
                    ui.item[0].dataset.currentstatus = groupStatus;
                }
            }
        });

        $(".assetDispatchAssetList-statusPrevButton,.assetDispatchAssetList-statusNextButton").click(function (){
            const assetCard = $(this).parent();
            const assetAssignment = assetCard.data("assignment");
            const assetNextStatus = $(this).data("nextstatus");
            changeStatus(parseInt(assetAssignment),parseInt(assetNextStatus));
            //move card to new status
            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetNextStatus + "][data-instance=" + assetCard.data("instance") + "]");
        });

        function doQuickDispatch() {
            const assetTag = $("#assetTagQuickDispatch").val();
            const assetStatus = $(".assetStatusSelectorQuickDispatch:visible").val();
            const instanceId = $(".assetStatusSelectorQuickDispatch:visible").data("instanceid");
            // Not using ajaxcall so we can have our own error handling for the alert boxes
            $.ajax({
                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusByTag.php",
                type: "POST",
                dataType: "json",
                data: {
                    text: assetTag,
                    assetsAssignments_status: assetStatus,
                    projects_id: {{ project.projects_id }},
                    instances_id: instanceId
                },
                cache: false,
                success: function(result, status, data) {
                    if (result.result === true) {
                        window.playBarcodeSuccessTone();
                        const assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-asset=" + result.response.assets_id + "]");
                        assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
                        drawButtons();
                    } else {
                        notifyScanError();
                        Toast.fire({
                            type: 'error',
                            title: assetTag + ": " + result.error.message
                        });
                        const resultDiv = $("<div>").addClass("alert alert-danger").text(assetTag + ": " + result.error.message);
                        $("#assetTagResultQuickDispatch").prepend(resultDiv);
                    }
                    $("#assetTagQuickDispatch").val("");
                    $("#assetTagQuickDispatch").focus();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error("Quick dispatch request failed", jqXHR, textStatus, errorThrown);
                    notifyScanError();
                    Toast.fire({
                        type: 'error',
                        title: 'Could not update asset status. Please try again.'
                    });
                }
            });
        }
        $("#assetTagQuickDispatch").on("keydown", function(e) {
            if (e.key !== "Enter") {
                return;
            }
            e.preventDefault();
            doQuickDispatch();
        });
        $("#goQuickDispatch").on("click", doQuickDispatch);
        {% endif %}


        $('a.assetsBoardToggle[data-toggle="pill"]').on('click', function (e) {
            localStorage.setItem("activeTab-board", e.target.getAttribute('aria-controls'));
        })
    });
</script>