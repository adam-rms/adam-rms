<div class="p-2 scrolling-head h-100" >
    {% for status in instanceAssets %}
        {% if status.instances_id == instanceid %}
        <div class="col-2 pageAssetSortable">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ status['assetsAssignmentsStatus_name'] }}</h3>
                </div>
                <div class="card-body assetDispatchAssetList" data-statusid="{{ status['assetsAssignmentsStatus_id'] }}" data-instance="{{ instanceid }}">
                    {% for asset in status['assets'] %}
                        <div class="p-2 border border-secondary border-2 rounded mt-auto mb-2 assetDispatchAssetList-card" data-currentstatus="{{ status['assetsAssignmentsStatus_id'] }}" data-assignment="{{ asset['assetsAssignments_id'] }}" data-instance="{{ instanceid }}" data-asset="{{ asset['assets_id'] }}">
                            <div class="d-flex align-items-center">
                            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions%}
                                <button class="btn btn-sm btn-outline-secondary px-1 py-0 assetDispatchAssetList-statusPrevButton" data-nextstatus="" title="Previous status" style="display: none;">«</button>
                            {% endif %}
                            <span class="assetDispatchAssetList-assetId mx-2"><i>(
                                {% if asset['assets_id'] %}
                                    <a target="_blank" href="{{ CONFIG.ROOTURL }}/asset.php?id={{ asset['assetTypes_id'] }}&asset={{ asset['assets_id'] }}&instance={{ instanceid }}">{{ asset['assets_tag'] }}</a>
                                {% else %}
                                    {{ asset['assets_tag'] }}
                                {% endif %}
                            )</i></span>
                            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions%}
                                <button class="btn btn-sm btn-outline-secondary px-1 py-0 assetDispatchAssetList-statusNextButton" data-nextstatus="" title="Next status" style="display: none;">»</button>
                            {% endif %}
                            </div>
                            <div class="assetDispatchAssetList-name">{{ asset['assetTypes_name'] }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}
    {% endfor %}
</div>
