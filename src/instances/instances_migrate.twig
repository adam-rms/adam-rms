{% extends "assets/template.twig" %}

{% block content %}
<div class="row">
    <div class="col-lg-6 offset-lg-3 col-md-12" style="padding: 5px;">
        <div class="card px-2">
            <div class="card-header row">
                <h4 class="card-title my-auto">Migrate to the new version of AdamRMS</h4>
            </div>
            <div class="card-body">
                {% if instances|length > 0 %}
                <p>Choose the business to copy to the new version of AdamRMS at <strong>{{ callbackHost }}</strong>. Nothing in this business is changed or deleted.</p>
                <form method="post">
                    {% for instance in instances %}
                    <button type="submit" name="migrate_instances_id" value="{{ instance.instances_id }}" class="btn btn-primary btn-block">{{ instance.instances_name }}</button>
                    {% endfor %}
                </form>
                {% else %}
                <p>You don't have permission to migrate any of your businesses. Ask an administrator of the business to give your role the "Business: Migrate" permission.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
